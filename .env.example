OPENAI_API_KEY=your-api-key
# For Alibaba Cloud Model Studio / DashScope OpenAI-compatible mode:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Empty values use OPENAI_API_KEY/OPENAI_BASE_URL. For local Ollama use an
# OpenAI-compatible URL and a non-empty placeholder key such as "ollama".
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
OCR_MODEL=gpt-4o-mini
OCR_MAX_PAGES=
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
MAX_CONCURRENT_ANSWERS=8
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_FILES=10
MAX_UPLOAD_JOBS=5

DATA_DIR=data/raw
CHROMA_PERSIST_DIR=.chroma
