# Local Ollama demo. "ollama" is an SDK placeholder, not a credential.
# Download the two models first; alternatively replace model/endpoint/key with your own service.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:1.5b
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3

DATA_DIR=data/raw
KNOWLEDGE_BASE_ID=default
# Bootstrap only: after first CLI ingest, run maintain-indexes --migrate-legacy
# BEFORE starting the web server. The atomic runtime config then owns the active path.
CHROMA_PERSIST_DIR=.chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_MAX_INPUT_BYTES=512
EMBEDDING_BATCH_SIZE=10
RETRIEVAL_METHOD=hybrid
RETRIEVAL_TOP_K=20
CANDIDATE_POOL_SIZE=100
SIMILARITY_THRESHOLD=0.35
FUSION_METHOD=rrf

# Optional paid/external services; ordinary Markdown/TXT demo does not use them.
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
AUDIO_TRANSCRIBE_MODEL=
AUDIO_TRANSCRIBE_PROVIDER=openai
