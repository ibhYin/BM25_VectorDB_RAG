[Unit]
Description=Local BGE embedding service for RAG
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/webroot/rag
Environment=EMBEDDING_MODEL_DIR=/data/webroot/rag/models/bge-small-zh-v1.5
Environment=EMBEDDING_MODEL_NAME=bge-small-zh:q8_0
Environment=EMBEDDING_MODEL_FILE=model.onnx
Environment=OMP_NUM_THREADS=2
ExecStart=/opt/embedding/.venv/bin/uvicorn scripts.local_embedding_server:app --host 127.0.0.1 --port 11434
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
