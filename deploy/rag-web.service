[Unit]
Description=RAG knowledge workspace web service
After=network.target rag-embedding.service
Wants=rag-embedding.service

[Service]
Type=simple
WorkingDirectory=/data/webroot/rag
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/webroot/rag/.venv/bin/python -m app.main web --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
