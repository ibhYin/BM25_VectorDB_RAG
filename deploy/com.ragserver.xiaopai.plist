<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  把 RAG 后端做成常驻服务（开机自启、崩溃自动重拉）。
  结构照抄本机已验证可用的 com.ollama.xiaopai.plist。

  安装：
    cp deploy/com.ragserver.xiaopai.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ragserver.xiaopai.plist
  卸载：
    launchctl bootout gui/$(id -u)/com.ragserver.xiaopai

  改完 plist 要 bootout 再 bootstrap，launchd 不会自动重载。

  注意：只监听 127.0.0.1 —— 公网入口一律走 Caddy。**不要**改成 0.0.0.0：
  后端信任 X-User-ID 头，直接暴露就等于任何人都能冒充任何身份。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ragserver.xiaopai</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/envs/langchain/bin/python</string>
        <string>-m</string>
        <string>app.main</string>
        <string>web</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <!-- 必须设：.env 是 pydantic-settings 按「当前工作目录」找的，
         不设的话服务起来了也读不到任何配置，等于跑在默认值上。
         同时这里也是相对路径（data/raw、.chroma）的基准。 -->
    <key>WorkingDirectory</key>
    <string>/Volumes/xiaoPai/Documents/RAG+langchain+langgraph</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/yuhui</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>

    <!-- 必须调大。索引写入跑在 ThreadPoolExecutor 里，worker 是非 daemon，
         解释器退出时会 join 它们，所以**排队中的入库任务会先跑完再退出**。
         一次入库几分钟很正常，而 launchd 默认 20 秒就 SIGKILL —— 那才是真的
         在索引写一半时硬杀。给足时间，让服务自己收拾干净。 -->
    <key>ExitTimeOut</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/yuhui/Library/Logs/ragserver.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuhui/Library/Logs/ragserver.err.log</string>
</dict>
</plist>
