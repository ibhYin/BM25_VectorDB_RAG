# Template only: reserved example host/IP, not deployment credentials.
[req]
prompt = no
distinguished_name = dn
x509_extensions = v3_req

[dn]
CN = rag.example.com

[v3_req]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = rag.example.com
IP.1 = 192.0.2.10
